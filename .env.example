# BizAssist AI — Environment Configuration Template
# Copy this file to .env.local for local testing:
#   cp .env.example .env.local

# ==============================================================================
# 1. AI Assistant Provider Configuration (Server-Side Only)
# Never expose these keys in client-side code, HTML, or public repositories.
# ==============================================================================

# LLM Provider: "google" (Gemini), "anthropic" (Claude), or "openai" (GPT)
LLM_PROVIDER=google

# Your provider API Key:
# - Google AI Studio: https://aistudio.google.com/app/apikey
# - Anthropic Console: https://console.anthropic.com/settings/keys
# - OpenAI Platform: https://platform.openai.com/api-keys
LLM_API_KEY=your_api_key_here

# Model identifier:
# - For Google: "gemini-1.5-flash" (recommended, fast & low cost) or "gemini-2.0-flash"
# - For Anthropic: "claude-3-5-haiku-20241022" (recommended) or "claude-3-5-sonnet-20241022"
# - For OpenAI: "gpt-4o-mini" (recommended)
LLM_MODEL=gemini-1.5-flash

# ==============================================================================
# 2. Email Provider Configuration (Optional for Password Reset)
# If left blank, the app runs in Demo Mode showing reset code in UI
# ==============================================================================
EMAIL_PROVIDER=demo
EMAIL_API_KEY=your_email_api_key_here
EMAIL_FROM=support@bizassist.ai

# ==============================================================================
# 3. Supabase Integration (Optional Backend Persistence)
# ==============================================================================
SUPABASE_URL=https://imhfqkepsepiscyceoyk.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
