# BizAssist AI — Environment Configuration Template
# Copy this file to .env.local for local testing:
#   cp .env.example .env.local

# ==============================================================================
# 1. Google Gemini API Configuration (Serverless Backend Only)
# Get a free API key at: https://aistudio.google.com/app/apikey
# NEVER commit .env.local or expose this key in client-side HTML or JS.
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Legacy / alternative alias
LLM_PROVIDER=google
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.0-flash

# ==============================================================================
# 2. Email Provider Configuration (Optional for Password Reset)
# If left as demo, the app runs in demo mode displaying code in UI
# ==============================================================================
EMAIL_PROVIDER=demo
EMAIL_API_KEY=your_email_api_key_here
EMAIL_FROM=support@bizassist.ai

# ==============================================================================
# 3. Supabase Integration (Optional Backend Persistence)
# ==============================================================================
SUPABASE_URL=https://imhfqkepsepiscyceoyk.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
